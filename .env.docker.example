# Template for the .env file docker-compose reads.
# Copy to .env and fill in the real values you want to use locally.
# Never commit a populated .env — only this template.

# ---- Required for the AI features to do anything real ----
# Without this, tutor/essay/lesson all fall back to heuristic copy.
ANTHROPIC_API_KEY=

# ---- Required: server refuses to start without a JWT secret ----
# Generate fresh: python -c "import secrets; print(secrets.token_urlsafe(48))"
PADHAI_JWT_SECRET=

# ---- Required: admin app uses a separate JWT secret ----
ADMIN_JWT_SECRET=

# ---- Required for first admin signup (used by scripts/seed_demo.py) ----
ADMIN_BOOTSTRAP_TOKEN=

# ---- Optional: Razorpay sandbox for payment E2E ----
# Leave blank to skip the payment flow in seed/smoke tests.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Optional providers (each just disables its surface when unset) ----
# HEYGEN_API_KEY=
# DID_API_KEY=
# TAVUS_API_KEY=
# ELEVENLABS_API_KEY=
# BHASHINI_API_KEY=
