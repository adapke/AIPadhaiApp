__pycache__/
*.pyc
.venv/
venv/
node_modules/

# generated artifacts
*.mp4
*.mp3
demo_page.png
sample_slide.png
test_*.png
demo_script.json

# IDE — keep shared run configs, drop per-user state
.idea/*
!.idea/runConfigurations/
!.idea/runConfigurations/*.xml
.vscode/
*.swp
*.swo

# SQLite dev databases (created at runtime by SQLiteUserRepository)
*.db
*.db-shm
*.db-wal

# secrets — env files are never committed; share .env.example only
.env
.env.local
.env.*.local

# Cypress
cypress/videos/
cypress/screenshots/
cypress/downloads/
node_modules/
.coverage

# Local dev server runtime state
.padhai_server.pid
padhai_server.log
padhai_server.err.log

# Local-only docker overrides + transient compose logs (machine-specific,
# e.g. host-port-conflict workarounds — never committed).
docker-compose.override.yml
compose_up*.log

# Mobile (Capacitor) build outputs + generated iOS project. We commit the
# Android project scaffold (mobile/android/**) but never the build artifacts
# or the machine-local SDK path. The iOS project is regenerated by the
# macOS CI workflow (cap add ios) on every run, so it is not committed.
*.apk
*.aab
mobile/android/local.properties
mobile/ios/

# Mobile signing secrets — NEVER commit these (see MOBILE_RELEASE.md).
# Losing the upload keystore means you can never update the Android app;
# leaking it lets anyone publish as you.
*.jks
*.keystore
keystore.properties
key.properties
google-services.json
GoogleService-Info.plist
*.p8
*.p12
*.mobileprovision
