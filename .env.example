# AI Pathshala — local dev environment variables.
#
# Copy this to `.env` (gitignored) and fill in real values:
#     copy .env.example .env       # Windows
#     cp   .env.example .env       # macOS / Linux
#
# The IntelliJ run configs in .idea/runConfigurations/ already set
# the *secrets* below to safe dev defaults. This file is for the
# things the run configs intentionally don't ship — API keys.

# ── Required for video generation ──────────────────────────────────
# Without this the /lessons and /explain endpoints will fail. Get a
# key at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-...

# ── Auth gate ──────────────────────────────────────────────────────
# Set to 0 in dev to allow anonymous access. MUST be 1 (default) in prod.
PADHAI_REQUIRE_AUTH=0

# ── JWT secrets ────────────────────────────────────────────────────
# Already set in the IntelliJ run configs to dev placeholders.
# In production these must be distinct random 32+ byte strings.
PADHAI_JWT_SECRET=dev-padhai-secret-change-me-locally-please
ADMIN_JWT_SECRET=dev-admin-secret-change-me-locally-please

# ── Email / SMTP (optional in dev) ────────────────────────────────
# Without these, password-reset links are printed to the server console.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxx
# SMTP_FROM=noreply@aipadhaiapp.com
# APP_BASE_URL=https://aipadhaiapp.com

# ── Voice & avatar (optional in dev) ───────────────────────────────
# Free / robotic fallbacks are used when these aren't set:
#   - TTS: espeak-ng (formant synthesis; install via Windows-friendly
#                     'choco install espeak-ng' or 'scoop install espeak-ng')
#   - Avatar: cartoon (built-in)
#
# Production picks Piper / Bhashini / ElevenLabs and a hosted avatar
# provider. See padhai/tts.py:get_provider() for the routing logic.
# PIPER_MODEL=C:\path\to\en-us-amy-low.onnx
# PIPER_MODEL_HI=C:\path\to\hi_IN-pratham-medium.onnx
# BHASHINI_API_KEY=
# ELEVENLABS_API_KEY=
# HEYGEN_API_KEY=

# ── Storage (optional in dev) ──────────────────────────────────────
# Without S3_* the local disk under ~/.padhai/ is used as the cache.
# In production these point to Cloudflare R2 (or S3/MinIO).
# S3_BUCKET=padhai-videos-dev
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL_BASE=

# ── Database (optional in dev) ─────────────────────────────────────
# When unset, jobs live in ~/.padhai/jobs.db (SQLite) — perfect for
# dev. Production sets this to a Postgres connection string.
# DATABASE_URL=postgresql://user:pass@host:5432/padhai
