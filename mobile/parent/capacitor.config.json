{
  "appId": "in.aipathshala.parent",
  "appName": "AI Pathshala — Parent",
  "webDir": "../../padhai/static",
  "server": {
    "url": "https://app.aipathshala.in/ui?mode=parent",
    "cleartext": false,
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#10B981",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "App": {
      "deepLinks": [
        "aipathshala-parent://",
        "https://app.aipathshala.in/parent"
      ]
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#10B981"
    }
  },
  "android": {
    "minSdkVersion": 24,
    "targetSdkVersion": 34
  },
  "ios": {
    "scheme": "AIPathshalaParent"
  }
}
