{
  "appId": "in.aipathshala.teacher",
  "appName": "AI Pathshala — Teacher",
  "webDir": "../../padhai/static",
  "server": {
    "url": "http://10.0.2.2:8000/ui?mode=teacher",
    "cleartext": true,
    "androidScheme": "http"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#7C3AED",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "App": {
      "deepLinks": [
        "aipathshala-teacher://",
        "https://app.aipathshala.in/teacher"
      ]
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#7C3AED"
    }
  },
  "android": {
    "minSdkVersion": 24,
    "targetSdkVersion": 34
  },
  "ios": {
    "scheme": "AIPathshalaTeacher"
  }
}
